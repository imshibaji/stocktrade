# ---------------------------------------------------------------------------
# Environment variables understood by the StockTrade container.
#
# Pass these with `docker run -e KEY=value ...` or the compose
# `environment:` block. (This file is documentation only.)
#
# IMPORTANT: use the underscore form for CodeIgniter config keys
#   app_baseURL            (not app.baseURL)
#   app_forceGlobalSecureRequests
# Apache's mod_php drops environment variable names that contain a dot, so
# the dotted form is silently ignored inside the container. CodeIgniter
# accepts both, so the underscore form is the one that works here.
# ---------------------------------------------------------------------------

# CodeIgniter environment: development | testing | production
CI_ENVIRONMENT = production

# Base URL the app builds links with. Must end with a slash and match the
# host port you publish (see docker-compose.yml).
app_baseURL = http://localhost:8080/

# Force HTTPS (leave false when running behind a plain HTTP proxy).
app_forceGlobalSecureRequests = false

# --- Container behaviour ----------------------------------------------------
# Run pending migrations on start.
AUTO_MIGRATE = true
# Seed sample stock data on start (only needed once, on an empty database).
AUTO_SEED = false
# Seeder class to run when AUTO_SEED is true.
SEEDER_CLASS = StockSeeder
