{
  "name": "tickmoss",
  "version": "1.0.0",
  "description": "Tailwind CSS + daisyUI front-end build for Tickmoss — a self-hosted, open-source stock analysis, AI price prediction and portfolio tracking app.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "npx @tailwindcss/cli -i src/tailwind.css -o public/css/style.css --watch",
    "build:css": "npx @tailwindcss/cli -i src/tailwind.css -o public/css/style.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imshibaji/stocktrade.git"
  },
  "keywords": [
    "tailwindcss",
    "daisyui",
    "stock-analysis",
    "stock-screener",
    "portfolio-tracker",
    "self-hosted",
    "open-source"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/imshibaji/stocktrade/issues"
  },
  "homepage": "https://github.com/imshibaji/stocktrade#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "daisyui": "^5.7.14"
  }
}
